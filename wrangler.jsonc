{
  // Cloudflare Worker that serves the MUSE Dallas site as static files.
  // Everything in ./public is uploaded; _headers in that folder sets caching.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "muse-dallas",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": { "enabled": true }
}
